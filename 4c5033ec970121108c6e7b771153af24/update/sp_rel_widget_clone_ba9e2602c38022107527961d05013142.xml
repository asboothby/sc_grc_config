            {{data.text.button_label}}
          &lt;/a&gt;
        &lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="col-sm-12 row-border"&gt;&lt;/div&gt;
    &lt;/div&gt;

  &lt;/div&gt;
&lt;/div&gt;]]&gt;&lt;/template&gt;&lt;/sp_widget&gt;</payload>
