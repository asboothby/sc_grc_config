}&lt;/css&gt;&lt;data_table&gt;sp_instance&lt;/data_table&gt;&lt;demo_data/&gt;&lt;description/&gt;&lt;docs/&gt;&lt;field_list/&gt;&lt;has_preview&gt;false&lt;/has_preview&gt;&lt;id&gt;grc-assessment-list&lt;/id&gt;&lt;internal&gt;false&lt;/internal&gt;&lt;link&gt;&lt;![CDATA[function link(scope, element, attrs, controller) {  }]]&gt;&lt;/link&gt;&lt;name&gt;GRC Assessment List&lt;/name&gt;&lt;option_schema/&gt;&lt;public&gt;false&lt;/public&gt;&lt;roles&gt;snc_internal&lt;/roles&gt;&lt;script&gt;&lt;![CDATA[(function() {
    var type = options.type || 'attestation'; //attestation, risk, tiering
    var utils = new sn_grc.GRCAssessmentUtils();
    var list = utils.getAssessments(type);

    data.list = list;

    var text = {};

    if (type == 'attestation')
        text = {
            'no_result': gs.getMessage('You have no attestations.'),
            'your_list': gs.getMessage('Your Attestations'),
            'column_label': gs.getMessage('Attestation'),
            'button_label': gs.getMessage('Take Attestation')
        }
    else if (type == 'risk')
        text = {
            'no_result': gs.getMessage('You have no risk assessments.'),
            'your_list': gs.getMessage('Your Assessments'),
            'column_label': gs.getMessage('Assessment'),
            'button_label': gs.getMessage('Take Assessment')
        }
    else if (type == 'tiering')
        text = {
            'no_result': gs.getMessage('You have no tiering assessments.'),
            'your_list': gs.getMessage('Your Assessments'),
            'column_label': gs.getMessage('Assessment'),
            'button_label': gs.getMessage('Take Assessment')
        }
    else if (type == 'privacy')
        text = {
            'no_result': gs.getMessage('You have no privacy assessments.'),
            'your_list': gs.getMessage('Your Assessments'),
            'column_label': gs.getMessage('Assessment'),
            'button_label': gs.getMessage('Take Assessment')
        }

    data.text = text;
})();]]&gt;&lt;/script&gt;&lt;servicenow&gt;false&lt;/servicenow&gt;&lt;sys_class_name&gt;sp_widget&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2019-07-19 21:11:32&lt;/sys_created_on&gt;&lt;sys_id&gt;37ec01f4877233003058d1a936cb0be4&lt;/sys_id&gt;&lt;sys_mod_count&gt;21&lt;/sys_mod_count&gt;&lt;sys_name&gt;GRC Assessment List&lt;/sys_name&gt;&lt;sys_package display_value="GRC: Profiles" source="sn_grc"&gt;53f81621cb200200829cf865734c9c58&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="GRC: Profiles"&gt;53f81621cb200200829cf865734c9c58&lt;/sys_scope&gt;&lt;sys_update_name&gt;sp_widget_37ec01f4877233003058d1a936cb0be4&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2022-04-06 09:36:09&lt;/sys_updated_on&gt;&lt;template&gt;&lt;![CDATA[&lt;div ng-if="!data.list.length" class="alert alert-info"&gt;
  {{data.text.no_result}}
&lt;/div&gt;

&lt;div ng-if="data.list.length" class="panel panel-{{::options.color}} b vdp"&gt;

