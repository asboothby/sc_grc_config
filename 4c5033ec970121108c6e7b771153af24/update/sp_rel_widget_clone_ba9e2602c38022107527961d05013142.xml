          &lt;strong class="col-xs-4 visible-xs"&gt;${Number}&lt;/strong&gt;
          &lt;div class="col-xs-8 col-sm-12"&gt;{{::asmt.number}}&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="col-sm-5 cell no-gutter"&gt;
          &lt;strong class="col-xs-4 visible-xs"&gt;{{data.text.column_label}}&lt;/strong&gt;
          &lt;div class="col-xs-8 col-sm-12"&gt;{{::asmt.metric_type}}&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="col-sm-3 cell no-gutter"&gt;
          &lt;strong class="col-xs-4 visible-xs"&gt;${Due Date}&lt;/strong&gt;
