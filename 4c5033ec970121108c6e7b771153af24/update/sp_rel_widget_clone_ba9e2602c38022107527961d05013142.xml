    &lt;div class="header hidden-xs" role="row"&gt;
      &lt;div class="col-sm-1 cell"&gt;${Number}&lt;/div&gt;
      &lt;div class="col-sm-5 cell"&gt;{{data.text.column_label}}&lt;/div&gt;
