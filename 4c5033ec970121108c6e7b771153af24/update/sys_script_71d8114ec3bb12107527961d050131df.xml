        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	if (current.failed_indicators + current.passed_indicators > 0 && !current.attestation){
		current.x_631631_sc_grc_co_answer_method='indicator';
	}
	else {
		var grAIQ = new GlideRecord('asmt_assessment_instance_question');
		grAIQ.addQuery('source_id', current.sys_id);
		grAIQ.addQuery('metric', '53681152df101200dca6a5f59bf263f1');
		grAIQ.query();
		if(grAIQ.next()) {
			if(grAIQ.string_value=='Answered Yes by Trigger Question') {
				current.x_631631_sc_grc_co_answer_method='trigger_question';
			}
			else {
				current.x_631631_sc_grc_co_answer_method='manual';
			}

		}

	}

})(current, previous);]]></script>
